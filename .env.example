# ScholarAI Workforce - environment configuration
#
# Copy this file to `.env` and fill in what you need. Every value here has a
# safe default (see src/scholarai/infrastructure/config/settings.py), so the
# project runs with ZERO configuration: no API key -> the LLM layer falls
# back to a deterministic "offline" mode (infrastructure/llm/offline_client.py)
# instead of failing, and no DATABASE_URL/QDRANT_URL -> local SQLite +
# in-memory Qdrant. Nothing below is a real secret.

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
SCHOLARAI_ENVIRONMENT=development          # development | test | production
SCHOLARAI_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM provider (nested settings -> SCHOLARAI_LLM__<FIELD>)
# provider = openai | anthropic | ollama | offline
# Leaving the API key blank automatically falls back to `offline` mode.
# ---------------------------------------------------------------------------
SCHOLARAI_LLM__PROVIDER=openai
SCHOLARAI_LLM__OPENAI_API_KEY=
SCHOLARAI_LLM__OPENAI_MODEL=gpt-4o-mini
SCHOLARAI_LLM__ANTHROPIC_API_KEY=
SCHOLARAI_LLM__ANTHROPIC_MODEL=claude-3-5-haiku-latest
SCHOLARAI_LLM__OLLAMA_BASE_URL=http://localhost:11434
SCHOLARAI_LLM__OLLAMA_MODEL=llama3.1
SCHOLARAI_LLM__TEMPERATURE=0.2
SCHOLARAI_LLM__MAX_TOKENS=2000

# ---------------------------------------------------------------------------
# Database (SCHOLARAI_DATABASE__<FIELD>)
# Default: local SQLite file under data/scholarai.db - zero setup.
# For Docker Compose / production, point at PostgreSQL instead:
#   SCHOLARAI_DATABASE__URL=postgresql+asyncpg://scholarai:scholarai@postgres:5432/scholarai
# ---------------------------------------------------------------------------
SCHOLARAI_DATABASE__URL=
SCHOLARAI_DATABASE__ECHO=false

# ---------------------------------------------------------------------------
# Vector store (SCHOLARAI_VECTORSTORE__<FIELD>)
# Default: blank -> in-process (":memory:") Qdrant, good enough for a laptop
# demo but not persisted across restarts. For Docker Compose:
#   SCHOLARAI_VECTORSTORE__URL=http://qdrant:6333
# ---------------------------------------------------------------------------
SCHOLARAI_VECTORSTORE__URL=
SCHOLARAI_VECTORSTORE__COLLECTION_PREFIX=scholarai

# ---------------------------------------------------------------------------
# API security (SCHOLARAI_API__<FIELD>)
# Empty api_keys -> unauthenticated dev mode (loud warning per request).
# `environment=production` REFUSES to boot without at least one key here.
# Pydantic-settings parses tuple/list fields from JSON, e.g.:
#   SCHOLARAI_API__API_KEYS=["change-me-to-a-real-secret"]
# ---------------------------------------------------------------------------
SCHOLARAI_API__API_KEYS=

# ---------------------------------------------------------------------------
# Optional web search tool (SCHOLARAI_WEBSEARCH__<FIELD>)
# Blank -> the web search tool reports itself unavailable rather than failing.
# ---------------------------------------------------------------------------
SCHOLARAI_WEBSEARCH__TAVILY_API_KEY=
SCHOLARAI_WEBSEARCH__ENABLED=true
# duckduckgo requires no key; set provider=tavily to use the key above.
SCHOLARAI_WEBSEARCH__PROVIDER=duckduckgo

# ---------------------------------------------------------------------------
# Human-in-the-loop (SCHOLARAI_REVIEW__<FIELD>)
# ---------------------------------------------------------------------------
SCHOLARAI_REVIEW__MAX_CRITIC_REVISIONS=2

# ---------------------------------------------------------------------------
# Optional LangSmith tracing (top-level, not nested)
# ---------------------------------------------------------------------------
SCHOLARAI_LANGCHAIN_TRACING_V2=false
SCHOLARAI_LANGCHAIN_API_KEY=

# ---------------------------------------------------------------------------
# Streamlit UI -> FastAPI backend (read directly by ui/streamlit_app/client.py,
# NOT by the backend, so no SCHOLARAI_ prefix)
# ---------------------------------------------------------------------------
SCHOLARAI_API_BASE_URL=http://localhost:8000
SCHOLARAI_API_KEY=
